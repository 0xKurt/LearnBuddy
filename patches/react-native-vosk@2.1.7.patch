+++ b/android/src/main/java/com/vosk/VoskCheck.kt
@@ -0,0 +1,70 @@
+package com.vosk
+
+// requires live verification on a real iPhone / Android phone
+import android.util.Base64
+import com.facebook.react.bridge.Promise
+import com.sun.jna.NativeLibrary
+import org.json.JSONArray
+import org.json.JSONObject
+import org.vosk.Model
+import org.vosk.Recognizer
+import java.util.concurrent.Executors
+
+/** Serial, bounded PCM checks; never opens a microphone or network connection. */
+internal class VoskCheck {
+  private val queue = Executors.newSingleThreadExecutor()
+  private var model: Model? = null
+  private var loadedPath: String? = null
+
+  fun check(path: String, encoded: String, grammar: String, promise: Promise) {
+    queue.execute {
+      try {
+        require(encoded.length <= 1280000 && path.startsWith("/"))
+        val pcm = Base64.decode(encoded, Base64.NO_WRAP)
+        require(pcm.isNotEmpty() && pcm.size % 2 == 0 && pcm.size <= 960000)
+        if (loadedPath != path) {
+          model?.close(); model = null; loadedPath = null
+          model = Model(path); loadedPath = path
+        }
+        val loaded = requireNotNull(model)
+        val requested = JSONArray(grammar)
+        require(requested.length() in 1..241)
+        val missing = JSONArray()
+        val accepted = JSONArray()
+        val findWord = NativeLibrary.getInstance("vosk").getFunction("vosk_model_find_word")
+        for (i in 0 until requested.length()) {
+          val word = requested.getString(i)
+          require(word.length in 1..60)
+          if (word == "[unk]" || findWord.invokeInt(arrayOf(loaded.pointer, word)) >= 0) {
+            accepted.put(word)
+          } else { missing.put(word) }
+        }
+        require((0 until accepted.length()).any { accepted.getString(it) == "[unk]" })
+        val words = JSONArray()
+        fun collect(raw: String) {
+          val segment = JSONObject(raw).optJSONArray("result") ?: return
+          for (i in 0 until segment.length()) words.put(segment.getJSONObject(i))
+        }
+        Recognizer(loaded, 16000.0f, accepted.toString()).use { rec ->
+          rec.setWords(true)
+          var offset = 0
+          while (offset < pcm.size) {
+            val end = minOf(offset + 8000, pcm.size)
+            val chunk = pcm.copyOfRange(offset, end)
+            if (rec.acceptWaveForm(chunk, chunk.size)) collect(rec.result)
+            offset = end
+          }
+          collect(rec.finalResult)
+        }
+        promise.resolve(JSONObject().put("words", words).put("unavailable", missing).toString())
+      } catch (e: Exception) { promise.reject("vosk_check", "Offline check unavailable", e) }
+    }
+  }
+  fun release(promise: Promise) {
+    queue.execute { model?.close(); model = null; loadedPath = null; promise.resolve(null) }
+  }
+  fun close() {
+    queue.execute { model?.close(); model = null; loadedPath = null }
+    queue.shutdown()
+  }
+}
