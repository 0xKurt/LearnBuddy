+++ b/ios/RNVoskCheck.mm
@@ -0,0 +1,71 @@
+// requires live verification on a real iPhone / Android phone
+#import "RNVoskCheck.h"
+#import "RNVoskModel.h"
+#import "Vosk-API.h"
+
+@implementation RNVoskCheck {
+  dispatch_queue_t _queue;
+  RNVoskModel *_model;
+  NSString *_path;
+}
+- (instancetype)init {
+  if ((self = [super init])) _queue = dispatch_queue_create("vosk.check", DISPATCH_QUEUE_SERIAL);
+  return self;
+}
+- (void)check:(NSString *)path pcm:(NSString *)encoded grammar:(NSString *)grammar
+      resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject {
+  dispatch_async(_queue, ^{
+    @try {
+      NSData *pcm = encoded.length <= 1280000 ? [[NSData alloc] initWithBase64EncodedString:encoded options:0] : nil;
+      if (!pcm || pcm.length == 0 || pcm.length % 2 || pcm.length > 960000 || ![path hasPrefix:@"/"]) {
+        reject(@"vosk_check", @"Invalid PCM or model path", nil); return;
+      }
+      if (![self->_path isEqualToString:path]) {
+        self->_model = nil; self->_path = nil;
+        NSError *error = nil;
+        self->_model = [[RNVoskModel alloc] initWithName:path error:&error];
+        if (!self->_model.model || error) { reject(@"vosk_check", @"Model unavailable", error); return; }
+        self->_path = path;
+      }
+      id requested = [NSJSONSerialization JSONObjectWithData:[grammar dataUsingEncoding:NSUTF8StringEncoding] options:0 error:nil];
+      if (![requested isKindOfClass:[NSArray class]] || [requested count] < 1 || [requested count] > 241) {
+        reject(@"vosk_check", @"Invalid grammar", nil); return;
+      }
+      NSMutableArray *missing = [NSMutableArray new], *accepted = [NSMutableArray new];
+      for (id word in requested) {
+        if (![word isKindOfClass:[NSString class]] || [word length] < 1 || [word length] > 60) {
+          reject(@"vosk_check", @"Invalid grammar word", nil); return;
+        }
+        if ([word isEqualToString:@"[unk]"] || vosk_model_find_word(self->_model.model, [word UTF8String]) >= 0) [accepted addObject:word];
+        else [missing addObject:word];
+      }
+      if (![accepted containsObject:@"[unk]"]) { reject(@"vosk_check", @"Missing unknown token", nil); return; }
+      NSData *json = [NSJSONSerialization dataWithJSONObject:accepted options:0 error:nil];
+      NSString *grm = [[NSString alloc] initWithData:json encoding:NSUTF8StringEncoding];
+      VoskRecognizer *rec = vosk_recognizer_new_grm(self->_model.model, 16000, grm.UTF8String);
+      if (!rec) { reject(@"vosk_check", @"Recognizer unavailable", nil); return; }
+      NSMutableArray *words = [NSMutableArray new];
+      void (^collect)(const char *) = ^(const char *raw) {
+        if (!raw) return;
+        NSData *data = [[NSString stringWithUTF8String:raw] dataUsingEncoding:NSUTF8StringEncoding];
+        NSDictionary *result = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+        if ([result[@"result"] isKindOfClass:[NSArray class]]) [words addObjectsFromArray:result[@"result"]];
+      };
+      @try {
+        vosk_recognizer_set_words(rec, 1);
+        const char *bytes = (const char *)pcm.bytes;
+        for (NSUInteger at = 0; at < pcm.length; at += 8000) {
+          int count = (int)MIN((NSUInteger)8000, pcm.length - at);
+          if (vosk_recognizer_accept_waveform(rec, bytes + at, count)) collect(vosk_recognizer_result(rec));
+        }
+        collect(vosk_recognizer_final_result(rec));
+      } @finally { vosk_recognizer_free(rec); }
+      NSData *output = [NSJSONSerialization dataWithJSONObject:@{@"words": words, @"unavailable": missing} options:0 error:nil];
+      resolve([[NSString alloc] initWithData:output encoding:NSUTF8StringEncoding]);
+    } @catch (NSException *exception) { reject(@"vosk_check", @"Offline check unavailable", nil); }
+  });
+}
+- (void)releaseModel:(RCTPromiseResolveBlock)resolve {
+  dispatch_async(_queue, ^{ self->_model = nil; self->_path = nil; resolve(nil); });
+}
+@end
