#!/usr/bin/env sh
# LearnBuddy pre-push gate (issues #330, #455): the full test suite, unless every pushed tree
# already passed it. The pre-commit hook only runs the tests related to what is staged, or the
# full suite when shared ground changed; this is where the rest is caught before it reaches a PR.
# A tree the full suite already passed in this worktree is not tested a second time
# (.husky/full-suite.sh); anything unclear runs the suite. CI runs it again on every PR.
# Don't bypass with --no-verify.

set -e
. "$(dirname "$0")/full-suite.sh"

if suite_proven_for_push "$1"; then
  echo "✓ pre-push gate green (full suite not repeated: every pushed tree already passed it)"
  exit 0
fi
echo "→ pre-push: full test suite"
full_suite || tests_failed
echo "✓ pre-push gate green"
