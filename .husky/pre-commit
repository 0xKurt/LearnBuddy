#!/usr/bin/env sh
# LearnBuddy pre-commit gate.
# Don't bypass with --no-verify. If this is red, the codebase is red — fix it.

set -e
. "$(dirname "$0")/full-suite.sh"

echo "→ typecheck"
pnpm -r --parallel typecheck

echo "→ lint (staged only)"
pnpm exec lint-staged

echo "→ engineering guards (copies, dead code, Ausnahmelisten — issue #313)"
# The per-file guards (file size, tokens only, raw Pressable) ran with lint-staged above;
# these look at the whole repository: docs/engineering-guards.md.
pnpm guards

# Tests (issue #330): only the test files that depend on what is staged — `vitest related`
# follows the import graph, so a changed module runs every test that imports it, directly or
# not. A change to what EVERY test stands on (the test harness, a migration, a shared contract,
# a package manifest or the lockfile, the hooks and the guards) runs the full suite. The full
# suite also runs in pre-push and in CI on every PR — nothing reaches main without it. A full
# green run here records the committed tree, so pushing that tree does not run the suite a
# second time (issue #455, .husky/full-suite.sh); a related run records nothing.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
shared=$(echo "$staged" | grep -E '^(apps/api/src/testing/|apps/mobile/testing/|infra/supabase/migrations/|packages/|package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|apps/[^/]+/package\.json|apps/[^/]+/vitest[^/]*|apps/[^/]+/tsconfig[^/]*|\.husky/|tools/)' || true)
if [ -n "$shared" ]; then
  echo "→ tests: full suite (shared ground changed: $(echo "$shared" | head -3 | tr '\n' ' '))"
  full_suite || tests_failed
else
  for ws in apps/api apps/mobile; do
    files=$(echo "$staged" | grep "^$ws/" | grep -E '\.(ts|tsx|js|mjs|json)$' | sed "s#^$ws/##" || true)
    [ -z "$files" ] && continue
    echo "→ tests related to the staged files in $ws"
    # shellcheck disable=SC2086
    pnpm -C "$ws" run test:related $files || tests_failed
  done
fi

# Mobile-bundle smoke test. The earlier gates (tsc, vitest) don't actually
# run the Metro bundler, so module-resolution issues (.js → .ts rewrites,
# missing assets, dropped transitive deps under pnpm, plugin chain breakage
# from an Expo SDK bump) sail through and only surface when `expo start`
# tries to bundle on a real device. The check below catches the same class
# of error at commit time. The same export (iOS and Android, with source maps)
# checks that apps/mobile/lib/licences.json still lists what the app ships and
# that every licence in it is allowed (tools/guards/licences.mjs, issue #493) —
# hence the lockfile in the trigger: an updated dependency changes what ships.
#
# Skip when no mobile-relevant files are staged so the typical
# server-only / docs-only commit stays fast.
mobile_changed=$(git diff --cached --name-only | grep -E '^apps/mobile/|^packages/|^pnpm-lock\.yaml$' || true)
if [ -n "$mobile_changed" ]; then
  echo "→ mobile bundle smoke (expo export ios + android, licences)"
  pnpm -F @learnbuddy/mobile bundle:check >/tmp/lb-bundle.log 2>&1 || {
    echo "✗ mobile bundle failed. Last 40 lines:" >&2
    tail -40 /tmp/lb-bundle.log >&2
    exit 1
  }
fi

echo "✓ pre-commit gate green"
