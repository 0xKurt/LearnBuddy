// knip: unused files, exports and dependencies (issue #313, docs/engineering-guards.md).
// It runs through tools/guards/knip.mjs, which compares its findings with what main has
// (measured there, issue #452): a new finding is red. Entries below are the ways code is
// started that knip cannot see itself.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Node scripts started by hand or from CI, the walkthrough specs, the guards themselves.
      "entry": ["scripts/**/*.mjs", "tests/web/**/*.{ts,mjs}", "tools/**/*.mjs"],
      "project": ["scripts/**/*.mjs", "tests/web/**/*.{ts,mjs}", "tools/**/*.mjs"],
    },
    "apps/api": {
      // Vercel's function entry, the evals and one-off scripts are run with tsx by hand.
      "entry": ["api/index.ts", "src/server.ts", "evals/**/*.ts", "scripts/*.{ts,mjs}"],
      "project": ["**/*.ts"],
    },
    "packages/shared-math": {
      // Data generators run by hand (scripts/maps.mjs reads Natural Earth, which is not in the
      // repository, issue #251).
      "entry": ["scripts/*.mjs"],
    },
    "apps/mobile": {
      // Platform twins (`*.web.ts`, `*.ios.ts`) are picked by Metro's resolver, not by an import path;
      // the component-test project is listed in vitest.workspace.ts. Expo config plugins
      // are named in app.json, global.css by NativeWind in metro.config.js.
      "entry": [
        "**/*.web.{ts,tsx}",
        "**/*.ios.{ts,tsx}",
        "vitest.components.config.ts",
        "testing/*.{ts,tsx}",
        "scripts/*.mjs",
        "plugins/*.js",
        "global.css",
        // metro.config.js resolves Expo's dev-only `expo/virtual/env` to this file (issue #291);
        // no import path names it, and knip does not load metro.config.js (below).
        "lib/processEnv.ts",
      ],
      "project": ["**/*.{ts,tsx}"],
      // metro.config.js needs NativeWind's tailwind config resolved from apps/mobile, which
      // knip cannot load; the expo plugin already knows the router's entry points.
      "metro": false,
    },
  },
  "ignoreDependencies": [
    // The guard wrappers start jscpd's and dependency-cruiser's binaries (tools/guards/clones.mjs,
    // tools/guards/boundaries.mjs).
    "jscpd",
    "dependency-cruiser",
    // NativeWind 4 resolves it at build time; its install guide lists it as a direct dependency.
    "react-native-css-interop",
    // scripts/deploy-check.sh installs Vercel's detector into a temp dir (LB_FS_DETECTORS_DIR).
    "@vercel/fs-detectors",
  ],
  // Programs on the machine, not from npm: psql (the API's role test), supabase (the CLI
  // behind `pnpm db:*`), espeak-ng (the voice evals synthesise test audio with it).
  "ignoreBinaries": ["psql", "supabase", "espeak-ng"],
}
