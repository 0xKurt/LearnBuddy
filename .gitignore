# macOS
.DS_Store

# Cowork sandbox leftovers (virtio-fs would not let us delete these)
.git.broken/
.git.alsobroken/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*

# Env / secrets
.env
.env.*
!.env.example

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
ios/Pods/
android/.gradle/
android/app/build/
android/build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Build outputs
build/
out/
.next/
.turbo/
.vercel/

# Coverage / test
coverage/
.nyc_output/

# Editor
.vscode/
.idea/
*.swp
*~

# Local work-in-progress parked outside the build (see eslint.config.mjs ignores)
wip/

# Misc
*.log
.cache/
infra/supabase/.temp/
infra/supabase/.branches/
supabase/.temp/
supabase/.branches/

# Web build for the browser walkthrough (scripts/web-walkthrough.sh)
dist-web/
test-results/
*.tsbuildinfo

# Firebase/Google service-account keys are secrets: upload them to Expo, never commit them
*firebase-adminsdk*.json
*service-account*.json
vertex-sa.json
# EAS local credentials (keystore passwords)
apps/mobile/credentials.json

# Maestro writes screenshots and recordings next to where it runs (issue #37).
.maestro/**/*.png
.maestro/**/*.mp4

# Overall-impression eval output (scripts/eval-impression.sh, issue #127)
.impression/
