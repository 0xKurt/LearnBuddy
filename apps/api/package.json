{
  "name": "@learnbuddy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "LB_REQUIRE_TEST_DB=1 vitest run",
    "dev:stack": "tsx src/testing/dev-stack.ts",
    "eval:buddy": "tsx evals/buddy/run.ts",
    "eval:buddy:compare": "tsx evals/buddy/compare.ts",
    "eval:concern": "tsx evals/concern/run.ts",
    "eval:grade10": "tsx evals/grade10/run.ts"
  },
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@hono/node-server": "^1.19.15",
    "@learnbuddy/shared-math": "workspace:*",
    "@learnbuddy/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "@vercel/functions": "^3.9.9",
    "google-auth-library": "^10.6.2",
    "hono": "^4.13.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "ts-fsrs": "^4.7.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^17.4.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
