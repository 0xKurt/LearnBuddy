# API configuration (validated in src/config.ts). Copy to .env.local for development.
# Never commit real values; in Vercel set them as project environment variables.

NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
# Direct Postgres connection. On Supabase use the transaction pooler URL of an EU region
# (docs/privacy.md; the API logs a warning at boot for any other region).
# Any non-local host is reached only over TLS with certificate verification (src/lib/db.ts);
# sslmode=disable/allow/prefer/no-verify in the URL is refused at boot.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Root certificate (PEM, inline) of the database server. Supabase signs its database
# certificates with its own CA: Dashboard → Database → SSL configuration → download.
DATABASE_CA_CERT=

# ── Supabase (token verification, photo storage) ─────────────────────────
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── Secrets ──────────────────────────────────────────────────────────────
# Shared with pg_cron (Vault secret lb_tick_secret). Required in production.
TICK_SECRET=
# HMAC key for the short-lived admin sessions (PIN gate), at least 32 characters.
ADMIN_TOKEN_SECRET=

# Version of the privacy text the app shows; consent must match it.
CONSENT_VERSION=2026-09-27

# Browser origins allowed to call the API (Expo web in development), comma-separated.
CORS_ORIGINS=http://localhost:8081
# Oldest app build still served (x-app-version); older builds are asked to update.
# MIN_APP_VERSION=1.0.0
# Practice forms switched off here (issue #296), comma-separated ItemKind values; a new form
# stays off in production until tested with the real model and seen by the owner.
# FORMS_OFF=grid_draw,find_error

# Node server only: run the scheduler in-process every N seconds (0 = off).
TICK_INTERVAL_SECONDS=60

# ── Models, audio and material search (direct EU project) ─────────────────
# Set the server-only EU project key in the environment, never commit it.
# 'disabled' keeps explicit offline development possible.
LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
OPENAI_MODEL_SMART=gpt-5.4-mini
OPENAI_MODEL_FAST=gpt-5.4-mini
# Per-purpose overrides; unspecified purposes follow their smart/fast tier.
# OPENAI_ROUTES={"safeguard":"gpt-5.4-mini","tutor":"gpt-5.4-mini"}
AUDIO_BACKEND=openai
OPENAI_MODEL_PRONOUNCE=gpt-realtime-2.1
OPENAI_MODEL_TRANSCRIBE=gpt-transcribe
EMBEDDING_BACKEND=openai
SPEECH_BACKEND=openai
OPENAI_MODEL_SPEECH=tts-1
# Partial voice overrides also change the speech cache identity.
# OPENAI_TTS_VOICES={"warm":"nova","bright":"shimmer","soft":"coral","friendly":"ash","clear":"echo","deep":"onyx"}
# Project residency and approved Zero Data Retention are separate operator prerequisites.
# See docs/decisions/openai-model-choice-2026-10-24.md for measurements and shutdown dates.

# Optional legacy provider: loaded only when explicitly selected; no Google env is needed above.
# LLM_BACKEND=vertex
# AUDIO_BACKEND=vertex
# EMBEDDING_BACKEND=vertex
# SPEECH_BACKEND=google
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_VERTEX_LOCATION=europe-west4
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# VERTEX_MODEL_SMART=eu/gemini-3.6-flash
# VERTEX_MODEL_FAST=eu/gemini-3.1-flash-lite
# VERTEX_ROUTES={"tutor":"eu/gemini-3.6-flash"}
# SPEECH_ENDPOINT=eu-texttospeech.googleapis.com

# ── Push (Expo) ──────────────────────────────────────────────────────────
# On (owner 15.10.2026, #677; docs/privacy.md §Processors). Each learner still decides in the
# app (opt-in; the parents' PIN under 16). `disabled` keeps every message in the app.
# EXPO_ACCESS_TOKEN is needed only once "Enhanced push security" is on in the Expo project.
PUSH_BACKEND=expo
EXPO_ACCESS_TOKEN=
