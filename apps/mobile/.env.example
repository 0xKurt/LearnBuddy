# App configuration. Copy to .env.local for development; do NOT commit it.
# All EXPO_PUBLIC_* values are bundled into the app at build time — never put
# anything here that must stay secret (the Supabase anon key is public by design).
# Never an administrator or server key (service role, sb_secret_…, ADMIN_TOKEN_SECRET, a
# service account): anyone with the app can read every EXPO_PUBLIC_* value, and one such
# token once sat in every locally built bundle (issue #290). Metro refuses to start while an
# EXPO_PUBLIC_* name or value looks like one (metro.config.js → scripts/client-secrets.cjs).
# Those keys belong in apps/api/.env.local or the server's own environment only.
# Editing this file needs a Metro restart (no hot reload, lib/processEnv.ts).
# To run the dev build against the local test stack instead: sh scripts/dev-local-stack.sh
# (it ignores this file entirely; docs/architecture.md §Testing).

# API base URL without /v1 (the app appends it). Production builds require https://.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Supabase project (Auth): URL and the public anon key.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Full privacy policy page linked from the consent screen and settings › "Über LearnBuddy".
EXPO_PUBLIC_PRIVACY_URL=
# Imprint (Impressum) page and support e-mail address, shown in settings › "Über LearnBuddy".
# Leave empty to hide the row (the app never shows a placeholder address).
EXPO_PUBLIC_IMPRINT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Crash reports (issue #36). Empty — the default — means no crash reporting at all:
# the Sentry SDK is never started and nothing leaves the phone. A value must be a DSN of
# a Sentry organisation in the EU region (its host ends in .ingest.de.sentry.io); any
# other host stops the app on start (lib/env.ts, docs/privacy.md §Processors).
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only, never bundled: where `eas build` uploads the source maps, so a report
# reads as file names instead of minified noise. Both must be set or the Sentry build
# plugin is left out entirely (apps/mobile/app.config.ts). The upload itself also needs
# SENTRY_AUTH_TOKEN as an EAS secret — never in this file.
SENTRY_ORG=
SENTRY_PROJECT=
