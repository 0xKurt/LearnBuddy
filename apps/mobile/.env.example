# App configuration. Copy to .env.local for development; do NOT commit it.
# All EXPO_PUBLIC_* values are bundled into the app at build time — never put
# anything here that must stay secret (the Supabase anon key is public by design).

# API base URL without /v1 (the app appends it). Production builds require https://.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Supabase project (Auth): URL and the public anon key.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Full privacy policy page linked from the consent screen and settings › "Über LearnBuddy".
EXPO_PUBLIC_PRIVACY_URL=
# Imprint (Impressum) page and support e-mail address, shown in settings › "Über LearnBuddy".
# Leave empty to hide the row (the app never shows a placeholder address).
EXPO_PUBLIC_IMPRINT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
