{
  "expo": {
    "name": "LearnBuddy",
    "slug": "learnbuddy",
    "scheme": "learnbuddy",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f0eee9"
    },
    "ios": {
      "bundleIdentifier": "com.learnbuddy.app",
      "supportsTablet": false,
      "associatedDomains": ["applinks:learnbuddy.app"],
      "infoPlist": {
        "NSCameraUsageDescription": "Damit du Arbeitsblätter fotografieren kannst.",
        "NSPhotoLibraryUsageDescription": "Damit du Fotos von Arbeitsblättern auswählen kannst."
      }
    },
    "android": {
      "package": "com.learnbuddy.app",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#f0eee9"
      },
      "permissions": ["CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "learnbuddy.app"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Damit du Fotos von Arbeitsblättern auswählen kannst.",
          "cameraPermission": "Damit du Arbeitsblätter fotografieren kannst."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#b1715c"
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Damit du Sätze laut üben kannst und Buddy dir sagt, wie deine Aussprache klingt."
        }
      ]
    ]
  }
}
